# Postgres connection string (Vercel Postgres / Neon, or local Postgres for development)
POSTGRES_URL=postgresql://127.0.0.1:5432/fare_farms

# Long random string used to sign Payload auth tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Vercel Blob token for media uploads (Vercel dashboard → Storage → Blob). Leave empty locally to store uploads on disk.
BLOB_READ_WRITE_TOKEN=

# Public site URL, used for sitemap, canonical URLs and structured data
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: privacy-friendly, cookie-free analytics (Plausible). Leave empty to disable analytics entirely.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
